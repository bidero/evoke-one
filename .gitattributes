# Paczka aktualizacji = sam kod wtyczki.
#
# Aktualizator (includes/99-github-updater.php) pobiera zipball GitHuba,
# a ten pomija wszystko, co ma tu `export-ignore`. Do 1.231.x na każdą
# stronę jechały testy z sondami PHP, narzędzia i szkice.
#
# Nowy plik albo katalog w korzeniu repozytorium trzeba świadomie dopisać:
# tutaj (poza paczką) albo do listy dozwolonych w tests/drobiazgi.test.js
# (w paczce) — inaczej strażnik zapali się na czerwono.
/tests                  export-ignore
/tools                  export-ignore
/docs                   export-ignore
/.github                export-ignore
/CLAUDE.md              export-ignore
/phpstan.neon           export-ignore
/phpstan-baseline.neon  export-ignore
/package.json           export-ignore
/package-lock.json      export-ignore
/composer.json          export-ignore
/.gitignore             export-ignore
/.gitattributes         export-ignore
